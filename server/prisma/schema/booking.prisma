model Booking {
  id              String        @id @default(uuid())
  startDate       DateTime
  endDate         DateTime
  totalPrice      Decimal       @db.Decimal(10, 2)
  paymentDeadline DateTime?
  status          BookingStatus @default(PENDING)

  car             Car           @relation(fields: [carId], references: [id])
  carId           String

  renter          User          @relation(fields: [renterId], references: [id])
  renterId        String

  feedback        Feedback?
  payment         Payment?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([renterId,carId,startDate,endDate])
}

enum BookingStatus {
  PENDING    //	Renter requested the booking; waiting for owner approval.
  APPROVED   // Owner accepted; waiting for payment.

  IN_PROGRESS  // Payment is complete and the rental period has started. 
  COMPLETED    //	Rental period has ended.
  REJECTED     // 	Owner rejected the request.
  CANCELLED    // 	Booking was cancelled.
  EXPIRED        // Payment deadline passed without successful payment.
}