model Notification{
    id String @id @default(uuid())
    title String
    content String
    type  NotificationType
    isRead Boolean @default(false)
    user  User @relation(fields: [userId], references: [id])
    userId String
    createdAt DateTime @default(now())
}

enum NotificationType {
   
    BOOKING_REQUEST
    BOOKING_APPROVED
    BOOKING_REJECTED
    BOOKING_CANCELLED
    BOOKING_EXPIRED
    BOOKING_COMPLETED
    PAYMENT_SUCCESSFUL
    PAYMENT_FAILED
    NEW_MESSAGE
    CAR_APPROVED
    CAR_REJECTED
    CAR_SUSPENDED
    NEW_FEEDBACK
}